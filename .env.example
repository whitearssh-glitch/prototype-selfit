# 음성/TTS 속도: src/config/voice-speed.json (ttsSpeed, browserUtteranceRate, lecturePlaybackRate)
# 학습 단계별 음성 힌트: src/config/tts-voices-by-level.json (브라우저 SpeechSynthesis 보이스 선택용; 단일 basic 폴백)
# POST /api/tts 는 발화할 텍스트 JSON만 반환(오디오 미생성), 실제 소리는 브라우저

# Google Gemini: 서버에서만 사용 (STT + Chat)
# - GEMINI_API_KEY 있으면 Role Play / Real Talk에서 음성→텍스트(STT) + Cathy 대화(Chat) 사용
# - 키 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI: STT(Whisper)·Real Talk AI 평가 등 (TTS 오디오 생성에는 사용하지 않음)
# - 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# VoiceRSS: 현재 앱 TTS 경로에서 미사용(예전 서버 오디오 TTS 잔여 설정)
VITE_VOICERSS_API_KEY=
